{
  "configs": [
    {
      "name": "default",
      "agents": {
        "default": {
          "command": "opencode",
          "args": [
            "acp"
          ]
        }
      },
      "exclude": [
        "node_modules",
        ".git",
        "dist",
        "target"
      ],
      "projectPath": "E:\\Project\\ModuleAgent",
      "summarization": {
        "enabled": true
      }
    }
  ],
  "defaultConfig": "default",
  "roles": [
    {
      "name": "模块生成角色",
      "description": "负责根据项目需求生成新模块，扫描源码目录结构并生成 module.md 文件",
      "visibleModulePaths": [],
      "agents": {
        "default": {
          "command": "npx",
          "args": [
            "-y",
            "@zed-industries/claude-code-acp@latest"
          ]
        }
      },
      "knowledgeRefs": [
        {
          "filename": "MODULE_FORMAT.md",
          "name": "Module.md 文件规范"
        }
      ]
    }
  ]
}
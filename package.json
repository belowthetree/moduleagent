{
  "name": "@belowthetree/module-agent",
  "version": "0.3.0",
  "description": "模块化 Agent 编排框架",
  "type": "module",
  "main": "out/main/index.cjs",
  "bin": {
    "module-agent": "./dist/cli.cjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:mcp-server": "esbuild src/protocol/mcp/server-entry.ts --bundle --outfile=dist/mcp-server.cjs --platform=node --format=cjs",
    "build:mcp-role-server": "esbuild src/protocol/mcp/role-server-entry.ts --bundle --outfile=dist/mcp-role-server.cjs --platform=node --format=cjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --outfile=dist/cli.cjs --platform=node --format=cjs --external:@opentui/core --external:@opentui/solid --external:@opentui/keymap",
    "build:electron": "electron-vite build && npm run build:mcp-server && npm run build:mcp-role-server && npm run build:cli",
    "electron": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder build",
    "dist:win": "npm run build:electron && electron-builder build --win",
    "dist:mac": "npm run build:electron && electron-builder build --mac",
    "dist:linux": "npm run build:electron && electron-builder build --linux",
    "dist:publish": "npm run build:electron && electron-builder build --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build:cli"
  },
  "build": {
    "appId": "com.moduleagent.app",
    "productName": "ModuleAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "src/**/*",
      "config/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": null
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@cfworker/json-schema": "^4.1.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@opentui/core": "^0.2.2",
    "@opentui/keymap": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "cosmiconfig": "^9.0.1",
    "element-plus": "^2.13.7",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "jq": "^1.7.2",
    "marked": "^15.0.4",
    "pinia": "^3.0.4",
    "simple-git": "^3.27.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.17.12",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.10",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.9.0",
    "html-encoding-sniffer": "^4.0.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@opentui/core-linux-x64": "0.2.2",
    "@opentui/core-win32-x64": "0.2.2"
  }
}

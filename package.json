{
  "name": "@belowthetree/module-agent",
  "version": "0.4.0",
  "description": "Module Agent orchestration framework",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:backend": "cargo build --manifest-path src-tauri/Cargo.toml -p module-agent-backend",
    "build": "npm run build:renderer && npm run build:backend",
    "dev": "npm run dev:renderer",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@cfworker/json-schema": "^4.1.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "cosmiconfig": "^9.0.1",
    "element-plus": "^2.13.7",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.4",
    "pinia": "^3.0.4",
    "simple-git": "^3.27.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.17.12",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
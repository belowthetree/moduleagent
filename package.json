{
  "name": "module-agent",
  "version": "0.1.0",
  "description": "模块化 Agent 编排框架",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "esbuild electron/renderer/renderer.ts --bundle --outfile=electron/renderer/renderer.js --platform=browser --format=iife",
    "build:main": "esbuild electron/main.ts --bundle --outfile=electron/main.cjs --platform=node --format=cjs --external:electron --external:fs-extra --external:gray-matter --external:marked --external:simple-git --external:zod --external:path --external:url --external:esbuild --external:@agentclientprotocol/sdk",
    "build:preload": "esbuild electron/preload.ts --bundle --outfile=electron/preload.cjs --platform=node --format=cjs --external:electron",
    "build:mcp-server": "esbuild src/protocol/mcp/server-entry.ts --bundle --outfile=dist/mcp-server.cjs --platform=node --format=cjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --outfile=dist/cli.cjs --platform=node --format=cjs --external:@opentui/core --external:@opentui/solid --external:@opentui/keymap",
    "build:electron": "npm run build:renderer && npm run build:main && npm run build:preload && npm run build:mcp-server && npm run build:cli",
    "electron": "npm run build:electron && electron .",
    "dist": "npm run build:renderer && electron-builder build --win portable",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "build": {
    "appId": "com.moduleagent.app",
    "productName": "ModuleAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": null
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@cfworker/json-schema": "^4.1.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@opentui/core": "^0.2.2",
    "@opentui/keymap": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "element-plus": "^2.13.7",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "jq": "^1.7.2",
    "marked": "^15.0.4",
    "pinia": "^3.0.4",
    "simple-git": "^3.27.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.17.12",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@opentui/core-linux-x64": "0.2.2",
    "@opentui/core-win32-x64": "0.2.2"
  }
}
